# 복사: cp config/example.env .env  (.env는 .gitignore로 제외됨)
# 실데이터 홈. 아래에 db, raw, photos, inbox, quarantine, exports/private, backups, logs를 둔다 (데이터 사전 §12)
J5_DATA_HOME=/path/outside/repo/j5_data
# 연구 식별자. 패키지·정본이 같은 값을 써야 반영된다 (데이터 사전 §3)
J5_STUDY_ID=
# 자료 모드: synthetic | private_real
J5_DATA_MODE=synthetic
