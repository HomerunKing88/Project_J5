{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://j5.local/schemas/assets_new.schema.json",
  "title": "<batch>.j5field.zip assets.new.json",
  "description": "J5-028 (ADR-21): 현장에서 기기가 만든 임시 매입 단위. 관측 패키지에 선택 파일로 들어가며, PC 반영기가 정본 assets 에 resolution_status=pending 으로 만든다. 위치점은 필지 안의 점(기기가 정함)이고 PNU 는 만든 필지의 참고값이다(연결은 PC 의 parcels-suggest → parcels-link 로 확인). 소유자·연락처 등 개인정보 필드는 없다.",
  "type": "array",
  "minItems": 1,
  "maxItems": 500,
  "items": {
    "type": "object",
    "additionalProperties": false,
    "required": [
      "asset_id",
      "label",
      "location_point",
      "data_mode",
      "created_at",
      "notes",
      "pnu",
      "origin"
    ],
    "properties": {
      "asset_id": {
        "type": "string",
        "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
      },
      "label": {
        "type": "string",
        "minLength": 1,
        "maxLength": 100
      },
      "location_point": {
        "type": "array",
        "minItems": 2,
        "maxItems": 2,
        "prefixItems": [
          {
            "type": "number",
            "minimum": -180,
            "maximum": 180
          },
          {
            "type": "number",
            "minimum": -90,
            "maximum": 90
          }
        ],
        "items": false
      },
      "data_mode": {
        "type": "string",
        "enum": [
          "synthetic",
          "private_real"
        ]
      },
      "created_at": {
        "type": "string",
        "format": "date-time",
        "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(\\.[0-9]+)?(Z|[+-][0-9]{2}:[0-9]{2})$"
      },
      "notes": {
        "type": [
          "string",
          "null"
        ],
        "maxLength": 500
      },
      "pnu": {
        "type": [
          "string",
          "null"
        ],
        "pattern": "^[0-9]{19}$"
      },
      "origin": {
        "type": "string",
        "const": "device"
      }
    }
  }
}
