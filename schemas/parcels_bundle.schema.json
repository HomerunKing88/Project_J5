{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://j5.local/schemas/parcels_bundle.schema.json",
  "title": "필지 경계·지번 번들 (.j5parcels.json, j5 parcels convert 출력·폰 지도 입력)",
  "description": "ADR-13. 연속지적도 SHP 를 조사 범위로 잘라 WGS84 GeoJSON FeatureCollection 으로 바꾼 파일. RFC 7946 의 추가 멤버(j5parcels·source·clip 등)를 쓴다. PNU 는 필지 외부 ID 이며 asset_id 가 아니다. 도형면적(area_m2_geom)은 공부면적이 아니다. 실제 자료 번들은 저장소·공개 배포에 넣지 않는다.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "type",
    "j5parcels",
    "data_mode",
    "generated_at",
    "source",
    "clip",
    "count",
    "bbox",
    "features"
  ],
  "properties": {
    "type": {
      "const": "FeatureCollection"
    },
    "j5parcels": {
      "const": "1.0.0"
    },
    "data_mode": {
      "type": "string",
      "enum": [
        "synthetic",
        "real"
      ]
    },
    "generated_at": {
      "type": "string",
      "format": "date-time",
      "pattern": "(Z|[+-][0-9]{2}:[0-9]{2})$"
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "file",
        "shp_sha256",
        "dbf_sha256",
        "crs",
        "encoding",
        "record_count",
        "geometry_version",
        "license",
        "fields"
      ],
      "properties": {
        "name": {
          "description": "자료명 (예: 연속지적도 서울특별시 종로구)",
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "file": {
          "description": "원본 .shp 파일 이름 (경로 없이)",
          "type": "string",
          "minLength": 1,
          "maxLength": 300
        },
        "shp_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "dbf_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "crs": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "epsg",
            "name",
            "ellipsoid",
            "datum_shift",
            "detected_from"
          ],
          "properties": {
            "epsg": {
              "type": [
                "integer",
                "null"
              ]
            },
            "name": {
              "type": "string"
            },
            "ellipsoid": {
              "type": "string",
              "enum": [
                "GRS80",
                "WGS84",
                "Bessel"
              ]
            },
            "datum_shift": {
              "type": [
                "string",
                "null"
              ],
              "enum": [
                "korean1985",
                null
              ]
            },
            "detected_from": {
              "type": "string",
              "enum": [
                "prj",
                "argument"
              ]
            }
          }
        },
        "encoding": {
          "type": "string",
          "minLength": 1
        },
        "record_count": {
          "description": "원본 SHP 의 전체 레코드 수 (자르기 전)",
          "type": "integer",
          "minimum": 0
        },
        "geometry_version": {
          "description": "도형 기준일 (배포 자료의 기준 시점, 사용자가 지정)",
          "type": "string",
          "format": "date",
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
        },
        "license": {
          "description": "이용허락 유형·출처 표시 문구. 확인 전이면 null",
          "type": [
            "string",
            "null"
          ],
          "maxLength": 500
        },
        "fields": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "clip": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "bbox",
        "center",
        "radius_m"
      ],
      "properties": {
        "bbox": {
          "$ref": "#/$defs/bbox"
        },
        "center": {
          "oneOf": [
            {
              "$ref": "#/$defs/lonlat"
            },
            {
              "type": "null"
            }
          ]
        },
        "radius_m": {
          "type": [
            "number",
            "null"
          ],
          "exclusiveMinimum": 0
        }
      }
    },
    "count": {
      "type": "integer",
      "minimum": 0
    },
    "bbox": {
      "oneOf": [
        {
          "$ref": "#/$defs/bbox"
        },
        {
          "type": "null"
        }
      ]
    },
    "warnings": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "attrs_sources": {
      "description": "J5-025: 필지 속성(properties.attrs)을 읽은 자료 목록 (VWorld 토지특성·토지이용계획·토지소유공간정보). 변환 번들은 최대 3개, 정본 파생본은 반영한 구역 수만큼. 없으면 생략",
      "type": "array",
      "maxItems": 60,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "kind",
          "name",
          "file",
          "shp_sha256",
          "dbf_sha256",
          "record_count",
          "rows_used",
          "fields"
        ],
        "properties": {
          "kind": {
            "type": "string",
            "enum": [
              "land_feature",
              "land_plan",
              "land_ownership"
            ]
          },
          "name": {
            "type": "string",
            "minLength": 1,
            "maxLength": 100
          },
          "file": {
            "type": "string",
            "minLength": 1,
            "maxLength": 300
          },
          "shp_sha256": {
            "$ref": "#/$defs/sha256"
          },
          "dbf_sha256": {
            "$ref": "#/$defs/sha256"
          },
          "record_count": {
            "type": "integer",
            "minimum": 0
          },
          "rows_used": {
            "type": "integer",
            "minimum": 0
          },
          "fields": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        }
      }
    },
    "study_id": {
      "description": "파생본(정본 parcels)에서만: 정본의 study_id. 폰은 설정의 study_id 와 대조한다",
      "type": "string",
      "minLength": 1,
      "maxLength": 100
    },
    "source_dataset_version": {
      "description": "파생본에서만: 생성 시점의 정본 dataset_version",
      "type": "integer",
      "minimum": 0
    },
    "features": {
      "type": "array",
      "maxItems": 8000,
      "items": {
        "$ref": "#/$defs/feature"
      }
    }
  },
  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "lon": {
      "type": "number",
      "minimum": -180,
      "maximum": 180
    },
    "lat": {
      "type": "number",
      "minimum": -90,
      "maximum": 90
    },
    "lonlat": {
      "type": "array",
      "minItems": 2,
      "maxItems": 2,
      "prefixItems": [
        {
          "$ref": "#/$defs/lon"
        },
        {
          "$ref": "#/$defs/lat"
        }
      ]
    },
    "bbox": {
      "type": "array",
      "minItems": 4,
      "maxItems": 4,
      "prefixItems": [
        {
          "$ref": "#/$defs/lon"
        },
        {
          "$ref": "#/$defs/lat"
        },
        {
          "$ref": "#/$defs/lon"
        },
        {
          "$ref": "#/$defs/lat"
        }
      ]
    },
    "ring": {
      "type": "array",
      "minItems": 4,
      "items": {
        "$ref": "#/$defs/lonlat"
      }
    },
    "polygon": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/ring"
      }
    },
    "feature": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type",
        "id",
        "geometry",
        "properties"
      ],
      "properties": {
        "type": {
          "const": "Feature"
        },
        "id": {
          "$ref": "#/$defs/pnu"
        },
        "geometry": {
          "oneOf": [
            {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "type",
                "coordinates"
              ],
              "properties": {
                "type": {
                  "const": "Polygon"
                },
                "coordinates": {
                  "$ref": "#/$defs/polygon"
                }
              }
            },
            {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "type",
                "coordinates"
              ],
              "properties": {
                "type": {
                  "const": "MultiPolygon"
                },
                "coordinates": {
                  "type": "array",
                  "minItems": 1,
                  "items": {
                    "$ref": "#/$defs/polygon"
                  }
                }
              }
            }
          ]
        },
        "properties": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "pnu",
            "label",
            "emd_code",
            "emd_name",
            "mountain",
            "bon",
            "bu",
            "jimok",
            "jibun_raw",
            "jibun_mismatch",
            "area_m2_geom",
            "area_missing_reason",
            "bbox"
          ],
          "properties": {
            "pnu": {
              "$ref": "#/$defs/pnu"
            },
            "label": {
              "description": "지도에 쓰는 짧은 지번 (예: 123-4, 산12-1)",
              "type": "string",
              "minLength": 1,
              "maxLength": 20
            },
            "emd_code": {
              "description": "PNU 앞 10자리 (법정동·리)",
              "type": "string",
              "pattern": "^[0-9]{10}$"
            },
            "emd_name": {
              "type": [
                "string",
                "null"
              ],
              "maxLength": 50
            },
            "mountain": {
              "type": "boolean"
            },
            "bon": {
              "type": "integer",
              "minimum": 0,
              "maximum": 9999
            },
            "bu": {
              "type": "integer",
              "minimum": 0,
              "maximum": 9999
            },
            "jimok": {
              "description": "원본 JIBUN 끝의 지목 글자. 없으면 null",
              "type": [
                "string",
                "null"
              ],
              "maxLength": 10
            },
            "jibun_raw": {
              "type": [
                "string",
                "null"
              ],
              "maxLength": 50
            },
            "jibun_mismatch": {
              "description": "원본 JIBUN 의 번호가 PNU 와 다르면 true (PNU 를 우선)",
              "type": "boolean"
            },
            "area_m2_geom": {
              "description": "원본 평면좌표에서 계산한 도형면적(㎡). 공부면적이 아니다. 계산할 수 없으면 null 과 사유",
              "type": [
                "number",
                "null"
              ],
              "minimum": 0
            },
            "area_missing_reason": {
              "type": [
                "string",
                "null"
              ],
              "enum": [
                "source_geographic_crs",
                null
              ]
            },
            "bbox": {
              "$ref": "#/$defs/bbox"
            },
            "geometry_version": {
              "description": "파생본(정본 parcels)에서만: 이 필지 도형의 기준일",
              "type": "string",
              "format": "date",
              "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
            },
            "asset_ids": {
              "description": "파생본에서만: 정본 asset_components 로 연결된 물건 (생성일 기준 유효한 연결)",
              "type": "array",
              "uniqueItems": true,
              "items": {
                "type": "string",
                "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
              }
            },
            "attrs": {
              "$ref": "#/$defs/attrs"
            }
          }
        }
      }
    },
    "pnu": {
      "type": "string",
      "pattern": "^[0-9]{19}$"
    },
    "attrs": {
      "description": "J5-025 필지 속성 (VWorld 토지특성·토지이용계획·토지소유공간정보에서 읽은 값 그대로, 확인·판단 아님). 공시지가는 ㎡당 원. 소유는 구분 코드·공유인수·변동일뿐이며 이름·주소·연령대·거주 구분은 담지 않는다",
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "jimok_name": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 20
        },
        "registered_area_m2": {
          "description": "토지대장 면적(공부면적, ㎡)",
          "type": [
            "number",
            "null"
          ],
          "minimum": 0
        },
        "official_land_price_krw_m2": {
          "description": "개별공시지가 (원/㎡)",
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        },
        "price_base_year": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 1990,
          "maximum": 2100
        },
        "price_base_month": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 1,
          "maximum": 12
        },
        "use_zone_1": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 60
        },
        "use_zone_2": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 60
        },
        "land_use_situation": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 60
        },
        "road_side": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 60
        },
        "terrain_height": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 60
        },
        "terrain_form": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 60
        },
        "plan_zones": {
          "type": "array",
          "maxItems": 100,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "code",
              "name",
              "relation"
            ],
            "properties": {
              "code": {
                "type": "string",
                "maxLength": 20
              },
              "name": {
                "type": [
                  "string",
                  "null"
                ],
                "maxLength": 200
              },
              "relation": {
                "type": [
                  "string",
                  "null"
                ],
                "maxLength": 20
              }
            }
          }
        },
        "plan_zones_truncated": {
          "description": "원본 이름 목록이 열 길이에 잘려 코드 수보다 적으면 true",
          "type": "boolean"
        },
        "ownership_kind_code": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 10
        },
        "ownership_kind": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 30
        },
        "co_owner_count": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        },
        "ownership_changed_on": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
        },
        "ownership_change_cause_code": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 10
        },
        "national_institution_code": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 10
        },
        "as_of": {
          "description": "속성 기준일 (파생본에만: 정본 parcel_attributes.as_of). 변환 번들에는 없고 번들의 도형 기준일이 기준일이다",
          "type": "string",
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
        }
      }
    }
  }
}
