{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://j5.local/schemas/calc_inputs.schema.json",
  "title": "계산 입력 (j5 calc far / equity / cash / plans). 데이터 사전 §9~§10, ADR-08",
  "description": "kind 로 구분한 네 종류. far: 용적률 기준 여유면적(§9). equity: 가격 기준 정규화와 매입 전체 필요자기자본(§10.1). cash: 사업기간 최대 필요자기자본(§10.2). plans: 개발안(현상 유지·리모델링·철거신축·공동매입) 후보별 필요자기자본·최대 현금 비교와 CSV(§9 후단, 릴리스 계획 §8 R5). 금액은 원 단위 정수, 면적은 ㎡. 미확인 값은 null 과 사유로 적고 0 으로 채우지 않는다. 계산기는 미확인 입력이 있으면 결과를 null 로 두고 알려진 항목만 보인다.",
  "type": "object",
  "required": [
    "kind"
  ],
  "properties": {
    "kind": {
      "type": "string",
      "enum": [
        "far",
        "equity",
        "cash",
        "plans"
      ]
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "kind": {
            "const": "far"
          }
        }
      },
      "then": {
        "$ref": "#/$defs/far"
      }
    },
    {
      "if": {
        "properties": {
          "kind": {
            "const": "equity"
          }
        }
      },
      "then": {
        "$ref": "#/$defs/equity"
      }
    },
    {
      "if": {
        "properties": {
          "kind": {
            "const": "cash"
          }
        }
      },
      "then": {
        "$ref": "#/$defs/cash"
      }
    },
    {
      "if": {
        "properties": {
          "kind": {
            "const": "plans"
          }
        }
      },
      "then": {
        "$ref": "#/$defs/plans"
      }
    }
  ],
  "$defs": {
    "uuid": {
      "type": "string",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
    },
    "date": {
      "type": "string",
      "format": "date",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
    },
    "note": {
      "type": [
        "string",
        "null"
      ],
      "maxLength": 2000
    },
    "area": {
      "description": "면적 값과 근거(basis 필수). value_m2 가 null 이면 reason(미확인 사유) 필수",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "value_m2",
        "basis"
      ],
      "properties": {
        "value_m2": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0
        },
        "basis": {
          "description": "근거 (공부·대장·검토 문서·추정 등)",
          "type": "string",
          "minLength": 1,
          "maxLength": 500
        },
        "as_of": {
          "oneOf": [
            {
              "$ref": "#/$defs/date"
            },
            {
              "type": "null"
            }
          ]
        },
        "document_id": {
          "oneOf": [
            {
              "$ref": "#/$defs/uuid"
            },
            {
              "type": "null"
            }
          ]
        },
        "reason": {
          "$ref": "#/$defs/note"
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "value_m2": {
                "type": "null"
              }
            }
          },
          "then": {
            "required": [
              "reason"
            ],
            "properties": {
              "reason": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        }
      ]
    },
    "krw": {
      "description": "원 단위 금액과 근거. amount_krw 가 있으면 basis(근거) 필수, null 이면 reason(미확인 사유) 필수",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "amount_krw"
      ],
      "properties": {
        "amount_krw": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "basis": {
          "$ref": "#/$defs/note"
        },
        "included_in_price": {
          "description": "이 비용이 가격(P)에 이미 들어 있으면 true (중복 계산 방지, 값은 0 으로 취급)",
          "type": "boolean",
          "default": false
        },
        "included_in": {
          "description": "다른 항목에 이미 포함돼 있으면 그 항목 키",
          "type": [
            "string",
            "null"
          ],
          "maxLength": 40
        },
        "vat_included": {
          "type": [
            "boolean",
            "null"
          ]
        },
        "reason": {
          "$ref": "#/$defs/note"
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "amount_krw": {
                "type": "null"
              }
            }
          },
          "then": {
            "required": [
              "reason"
            ],
            "properties": {
              "reason": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "amount_krw": {
                "type": "integer"
              }
            },
            "required": [
              "amount_krw"
            ]
          },
          "then": {
            "required": [
              "basis"
            ],
            "properties": {
              "basis": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        }
      ]
    },
    "far": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "asset_label",
        "site",
        "regulation",
        "current_gfa"
      ],
      "properties": {
        "kind": {
          "const": "far"
        },
        "asset_label": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "composition_as_of": {
          "oneOf": [
            {
              "$ref": "#/$defs/date"
            },
            {
              "type": "null"
            }
          ]
        },
        "site": {
          "description": "대지. statutory 가 법정 산정 대지면적 A 다. registered 와 excluded 만 있고 statutory_basis 가 registered_minus_excluded 면 A = registered − excluded 로 잇는다. 배치 검토영역(placement_envelope)은 A 를 대신하지 않는다",
          "type": "object",
          "additionalProperties": false,
          "required": [
            "statutory"
          ],
          "properties": {
            "registered_parcel": {
              "$ref": "#/$defs/area"
            },
            "register_site": {
              "$ref": "#/$defs/area"
            },
            "statutory_excluded": {
              "$ref": "#/$defs/area"
            },
            "statutory": {
              "$ref": "#/$defs/area"
            },
            "statutory_basis": {
              "type": "string",
              "enum": [
                "direct",
                "registered_minus_excluded"
              ],
              "default": "direct"
            },
            "placement_envelope": {
              "$ref": "#/$defs/area"
            },
            "area_constraints": {
              "type": "array",
              "maxItems": 50,
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "kind",
                  "excluded_from_denominator"
                ],
                "properties": {
                  "kind": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 100
                  },
                  "area_m2": {
                    "type": [
                      "number",
                      "null"
                    ],
                    "minimum": 0
                  },
                  "basis": {
                    "$ref": "#/$defs/note"
                  },
                  "excluded_from_denominator": {
                    "description": "법정 분모 제외 여부. unknown 이면 제외하지 않고 확인 대상으로 남긴다",
                    "type": "string",
                    "enum": [
                      "true",
                      "false",
                      "unknown"
                    ]
                  },
                  "reviewed_on": {
                    "oneOf": [
                      {
                        "$ref": "#/$defs/date"
                      },
                      {
                        "type": "null"
                      }
                    ]
                  }
                }
              }
            }
          }
        },
        "regulation": {
          "description": "적용 용적률 F(%)와 규제 버전",
          "type": "object",
          "additionalProperties": false,
          "required": [
            "applied_far_pct",
            "regulation_version"
          ],
          "properties": {
            "applied_far_pct": {
              "type": [
                "number",
                "null"
              ],
              "minimum": 0
            },
            "regulation_version": {
              "description": "적용 법령·지구단위계획의 이름과 시점 (예: '일반상업 600%, 2026-01 고시'). null 이면 적용 규제를 확정할 수 없어 결과를 내지 않는다",
              "type": [
                "string",
                "null"
              ],
              "maxLength": 300
            },
            "zoning": {
              "type": [
                "string",
                "null"
              ],
              "maxLength": 100
            },
            "end_date_confirmed": {
              "description": "규제의 종료일 확인 여부. false 면 재확인 필요 표시",
              "type": [
                "boolean",
                "null"
              ]
            },
            "reason": {
              "$ref": "#/$defs/note"
            }
          },
          "allOf": [
            {
              "if": {
                "properties": {
                  "applied_far_pct": {
                    "type": "null"
                  }
                }
              },
              "then": {
                "required": [
                  "reason"
                ],
                "properties": {
                  "reason": {
                    "type": "string",
                    "minLength": 1
                  }
                }
              }
            }
          ]
        },
        "current_gfa": {
          "description": "동일 구성 범위의 현재 용적률 산정용 연면적 C. 총연면적(total_gfa)과 분리한다",
          "type": "object",
          "additionalProperties": false,
          "required": [
            "far_gfa"
          ],
          "properties": {
            "far_gfa": {
              "$ref": "#/$defs/area"
            },
            "total_gfa": {
              "$ref": "#/$defs/area"
            }
          }
        },
        "note": {
          "$ref": "#/$defs/note"
        }
      }
    },
    "equity": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "asset_label",
        "price",
        "loan",
        "assumed_tenant_deposits",
        "costs"
      ],
      "properties": {
        "kind": {
          "const": "equity"
        },
        "asset_label": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "scenario": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 200
        },
        "price": {
          "description": "가격 입력 정규화 (§10.1). P 는 보증금 차감 전 전체 계약금액. net_after_deposit 는 deposit_already_deducted_krw 가 확인될 때만 P 를 복원한다. settlement_residual·unknown 은 P 를 확정하지 않는다",
          "type": "object",
          "additionalProperties": false,
          "required": [
            "price_input_basis",
            "price_input_krw"
          ],
          "properties": {
            "price_input_basis": {
              "type": "string",
              "enum": [
                "gross_contract",
                "net_after_deposit",
                "settlement_residual",
                "unknown"
              ]
            },
            "price_input_krw": {
              "type": [
                "integer",
                "null"
              ],
              "minimum": 0,
              "maximum": 9007199254740991
            },
            "deposit_already_deducted_krw": {
              "type": [
                "integer",
                "null"
              ],
              "minimum": 0,
              "maximum": 9007199254740991
            },
            "prepaid_krw": {
              "description": "기지급 계약금·중도금 (현금흐름 시점 구분용, P 에서 빼지 않는다)",
              "type": [
                "integer",
                "null"
              ],
              "minimum": 0
            },
            "vat_included": {
              "type": [
                "boolean",
                "null"
              ]
            },
            "settlement_basis": {
              "$ref": "#/$defs/note"
            },
            "reason": {
              "$ref": "#/$defs/note"
            }
          },
          "allOf": [
            {
              "if": {
                "properties": {
                  "price_input_krw": {
                    "type": "null"
                  }
                }
              },
              "then": {
                "required": [
                  "reason"
                ],
                "properties": {
                  "reason": {
                    "type": "string",
                    "minLength": 1
                  }
                }
              }
            }
          ]
        },
        "loan": {
          "description": "L: 새로 조달하는 실제 대출 또는 명시한 시나리오. deposit_netted_in_limit 가 true 면 금융기관 순대출 한도에 보증금 공제가 이미 들어 있어 D 를 다시 차감하지 않는다",
          "type": "object",
          "additionalProperties": false,
          "required": [
            "amount_krw",
            "kind"
          ],
          "properties": {
            "amount_krw": {
              "type": [
                "integer",
                "null"
              ],
              "minimum": 0,
              "maximum": 9007199254740991
            },
            "kind": {
              "type": "string",
              "enum": [
                "approved",
                "scenario",
                "unknown"
              ]
            },
            "ltv_assumption_pct": {
              "type": [
                "number",
                "null"
              ],
              "minimum": 0,
              "maximum": 100
            },
            "collateral_basis": {
              "type": [
                "string",
                "null"
              ],
              "enum": [
                "purchase_price_assumption",
                "appraisal",
                "lender_confirmed",
                null
              ]
            },
            "deposit_netted_in_limit": {
              "type": "boolean",
              "default": false
            },
            "reason": {
              "$ref": "#/$defs/note"
            }
          },
          "allOf": [
            {
              "if": {
                "properties": {
                  "amount_krw": {
                    "type": "null"
                  }
                }
              },
              "then": {
                "required": [
                  "reason"
                ],
                "properties": {
                  "reason": {
                    "type": "string",
                    "minLength": 1
                  }
                }
              }
            }
          ]
        },
        "assumed_tenant_deposits": {
          "description": "D: 정산에 반영되는 승계 보증금. 반환 의무는 그대로 남는다 (후속 유출)",
          "$ref": "#/$defs/krw"
        },
        "costs": {
          "description": "T 취득세 등, B 거래·실사비, V 별도 선지급 세액 등, R 초기 수선, E 예비현금. 없는 항목은 amount_krw 0 과 근거, 미확인은 null 과 사유",
          "type": "object",
          "additionalProperties": false,
          "required": [
            "acquisition_tax",
            "transaction_costs",
            "prepaid_taxes",
            "initial_repairs",
            "reserve_cash"
          ],
          "properties": {
            "acquisition_tax": {
              "$ref": "#/$defs/krw"
            },
            "transaction_costs": {
              "$ref": "#/$defs/krw"
            },
            "prepaid_taxes": {
              "$ref": "#/$defs/krw"
            },
            "initial_repairs": {
              "$ref": "#/$defs/krw"
            },
            "reserve_cash": {
              "$ref": "#/$defs/krw"
            }
          }
        },
        "note": {
          "$ref": "#/$defs/note"
        }
      }
    },
    "cash": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "asset_label",
        "flows",
        "reserve_cash_krw",
        "reserve_in_flows"
      ],
      "properties": {
        "kind": {
          "const": "cash"
        },
        "asset_label": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "scenario": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 200
        },
        "period_unit": {
          "type": "string",
          "enum": [
            "month",
            "quarter",
            "year",
            "date"
          ],
          "default": "month"
        },
        "flows": {
          "description": "시점별 순현금흐름 CF_t (유입 +, 유출 −). 소유자 자기자본 투입(owner_equity)은 유입에 넣지 않는다. 같은 시점의 여러 항목은 합한다",
          "type": "array",
          "minItems": 1,
          "maxItems": 2000,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "t",
              "amount_krw",
              "kind"
            ],
            "properties": {
              "t": {
                "description": "시점 (기간 번호 0,1,2… 또는 YYYY-MM-DD, 한 입력 안에서 혼용 금지)",
                "oneOf": [
                  {
                    "type": "integer",
                    "minimum": 0
                  },
                  {
                    "$ref": "#/$defs/date"
                  }
                ]
              },
              "amount_krw": {
                "type": [
                  "integer",
                  "null"
                ],
                "minimum": -9007199254740991,
                "maximum": 9007199254740991
              },
              "kind": {
                "type": "string",
                "enum": [
                  "purchase",
                  "rent",
                  "operating_cost",
                  "interest",
                  "principal",
                  "tax",
                  "deposit_return",
                  "deposit_received",
                  "eviction",
                  "design",
                  "construction",
                  "additional_loan",
                  "refund",
                  "vacancy",
                  "reserve",
                  "owner_equity",
                  "other"
                ]
              },
              "note": {
                "$ref": "#/$defs/note"
              },
              "reason": {
                "$ref": "#/$defs/note"
              }
            },
            "allOf": [
              {
                "if": {
                  "properties": {
                    "amount_krw": {
                      "type": "null"
                    }
                  }
                },
                "then": {
                  "required": [
                    "reason"
                  ],
                  "properties": {
                    "reason": {
                      "type": "string",
                      "minLength": 1
                    }
                  }
                }
              }
            ]
          }
        },
        "reserve_cash_krw": {
          "description": "별도 예비현금. flows 에 reserve 로 넣었으면 reserve_in_flows 를 true 로 하고 여기는 null",
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        },
        "reserve_in_flows": {
          "type": "boolean"
        },
        "note": {
          "$ref": "#/$defs/note"
        }
      }
    },
    "plans": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "asset_label",
        "plans"
      ],
      "properties": {
        "kind": {
          "const": "plans"
        },
        "asset_label": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "composition_as_of": {
          "oneOf": [
            {
              "$ref": "#/$defs/date"
            },
            {
              "type": "null"
            }
          ]
        },
        "plans": {
          "description": "후보 개발안. plan_id 는 파일 안에서 유일. 각 안은 equity(kind: equity)·cash(kind: cash) 입력을 통째로 품는다",
          "type": "array",
          "minItems": 1,
          "maxItems": 20,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "plan_id",
              "plan_kind",
              "label",
              "equity",
              "cash"
            ],
            "properties": {
              "plan_id": {
                "type": "string",
                "pattern": "^[a-z0-9_-]{1,40}$"
              },
              "plan_kind": {
                "type": "string",
                "enum": [
                  "keep",
                  "remodel",
                  "rebuild",
                  "joint_purchase"
                ]
              },
              "label": {
                "type": "string",
                "minLength": 1,
                "maxLength": 200
              },
              "equity": {
                "$ref": "#/$defs/equity"
              },
              "cash": {
                "$ref": "#/$defs/cash"
              },
              "appraisal": {
                "description": "감정가(또는 금융기관 확인 담보가). 매입가 가정으로 잡은 대출과의 차이를 본다",
                "$ref": "#/$defs/krw"
              },
              "construction": {
                "description": "공사기간과 공실. remodel·rebuild 는 필수. months 가 미확인이면 reason",
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "months"
                ],
                "properties": {
                  "months": {
                    "type": [
                      "integer",
                      "null"
                    ],
                    "minimum": 0,
                    "maximum": 120
                  },
                  "vacancy_months": {
                    "description": "공사로 임대수입이 끊기는 개월 수 (현금흐름의 vacancy 항목과 대조)",
                    "type": [
                      "integer",
                      "null"
                    ],
                    "minimum": 0,
                    "maximum": 120
                  },
                  "basis": {
                    "$ref": "#/$defs/note"
                  },
                  "reason": {
                    "$ref": "#/$defs/note"
                  }
                },
                "allOf": [
                  {
                    "if": {
                      "properties": {
                        "months": {
                          "type": "null"
                        }
                      }
                    },
                    "then": {
                      "required": [
                        "reason"
                      ],
                      "properties": {
                        "reason": {
                          "type": "string",
                          "minLength": 1
                        }
                      }
                    }
                  }
                ]
              },
              "joint": {
                "description": "공동매입안: 추가 가격·취득 순서·기간·한쪽만 확보했을 때의 운영안 (데이터 사전 §9). joint_purchase 는 필수",
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "extra_price",
                  "included_in_price",
                  "acquisition_order",
                  "period_months",
                  "partial_fallback"
                ],
                "properties": {
                  "extra_price": {
                    "$ref": "#/$defs/krw"
                  },
                  "included_in_price": {
                    "description": "추가 가격이 이 후보의 equity 가격(P)과 cash 흐름에 이미 들어 있으면 true. false 면 계산기가 후보를 미확정으로 둔다(임의로 더하지 않는다)",
                    "type": "boolean"
                  },
                  "acquisition_order": {
                    "type": "array",
                    "minItems": 1,
                    "maxItems": 20,
                    "items": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 200
                    }
                  },
                  "period_months": {
                    "type": [
                      "integer",
                      "null"
                    ],
                    "minimum": 0,
                    "maximum": 240
                  },
                  "partial_fallback": {
                    "description": "한쪽만 확보했을 때의 운영안",
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 2000
                  }
                }
              },
              "architect_review": {
                "description": "건축사 검토안 유무. 설계 가능 연면적·주차·높이·구조는 건축사의 안과 조건을 저장한다(계산기가 판정하지 않음)",
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "reviewed"
                ],
                "properties": {
                  "reviewed": {
                    "type": "boolean"
                  },
                  "document_id": {
                    "oneOf": [
                      {
                        "$ref": "#/$defs/uuid"
                      },
                      {
                        "type": "null"
                      }
                    ]
                  },
                  "reviewed_on": {
                    "oneOf": [
                      {
                        "$ref": "#/$defs/date"
                      },
                      {
                        "type": "null"
                      }
                    ]
                  },
                  "note": {
                    "$ref": "#/$defs/note"
                  }
                }
              },
              "assumptions": {
                "type": "array",
                "maxItems": 50,
                "items": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 1000
                }
              },
              "note": {
                "$ref": "#/$defs/note"
              }
            },
            "allOf": [
              {
                "if": {
                  "properties": {
                    "plan_kind": {
                      "enum": [
                        "remodel",
                        "rebuild"
                      ]
                    }
                  }
                },
                "then": {
                  "required": [
                    "construction"
                  ]
                }
              },
              {
                "if": {
                  "properties": {
                    "plan_kind": {
                      "const": "joint_purchase"
                    }
                  }
                },
                "then": {
                  "required": [
                    "joint"
                  ]
                }
              }
            ]
          }
        },
        "note": {
          "$ref": "#/$defs/note"
        }
      }
    }
  }
