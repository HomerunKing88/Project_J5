{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://j5.local/schemas/archive_manifest.schema.json",
  "title": "exports/private/archives/<stamp>-ds<version>-<run8>/archive_manifest.json (연말 개방형 포맷 보존본)",
  "description": "릴리스 계획 §8 R6, 데이터 사전 §12. 정본의 모든 사용자 표를 tables/<표>.jsonl(값 보존)·tables/<표>.csv(편의 사본)로, 위치점·필지를 GeoJSON 으로, 표 정의를 schema.sql 로, JSON Schema 사본을 schemas/ 로 담은 읽기용 스냅샷. 파일 목록·크기·해시와 표별 행 수·열 정의·버전을 담아 SQLite 없이 검증한다. 백업이 아니다.",
  "type": "object",
  "additionalProperties": false,
  "required": ["format", "archive_schema_version", "study_id", "data_mode", "dataset_version", "db_schema_version", "generated_at", "run_id", "tool", "photos_included", "counts", "tables", "files"],
  "properties": {
    "format": { "type": "string", "const": "j5archive" },
    "archive_schema_version": { "type": "string", "enum": ["1.0.0"] },
    "study_id": { "type": "string", "minLength": 1, "maxLength": 100 },
    "data_mode": { "type": "string", "enum": ["synthetic", "private_real"] },
    "dataset_version": { "type": "integer", "minimum": 0 },
    "db_schema_version": { "type": "integer", "minimum": 1 },
    "generated_at": { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$" },
    "run_id": { "type": "string", "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$" },
    "tool": {
      "type": "object",
      "additionalProperties": false,
      "required": ["app_version", "sqlite_version", "python_version"],
      "properties": {
        "app_version": { "type": "string", "minLength": 1 },
        "sqlite_version": { "type": "string", "minLength": 1 },
        "python_version": { "type": "string", "minLength": 1 }
      }
    },
    "photos_included": { "type": "boolean" },
    "counts": {
      "type": "object",
      "additionalProperties": false,
      "required": ["tables", "rows", "photos", "parcels", "assets_located"],
      "properties": {
        "tables": { "type": "integer", "minimum": 1 },
        "rows": { "type": "integer", "minimum": 0 },
        "photos": { "type": "integer", "minimum": 0 },
        "parcels": { "type": "integer", "minimum": 0 },
        "assets_located": { "type": "integer", "minimum": 0 }
      }
    },
    "tables": {
      "description": "정본의 모든 사용자 표 (이름순). 열 정의는 PRAGMA table_info 순서",
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "columns", "rows", "jsonl", "csv"],
        "properties": {
          "name": { "type": "string", "pattern": "^[a-z_][a-z0-9_]*$" },
          "columns": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["name", "type", "notnull", "pk"],
              "properties": {
                "name": { "type": "string", "minLength": 1 },
                "type": { "type": "string" },
                "notnull": { "type": "boolean" },
                "pk": { "type": "integer", "minimum": 0 }
              }
            }
          },
          "rows": { "type": "integer", "minimum": 0 },
          "jsonl": { "type": "string", "pattern": "^tables/[a-z_][a-z0-9_]*\\.jsonl$" },
          "csv": { "type": "string", "pattern": "^tables/[a-z_][a-z0-9_]*\\.csv$" }
        }
      }
    },
    "files": {
      "type": "array",
      "minItems": 4,
      "uniqueItems": true,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["path", "bytes", "sha256"],
        "properties": {
          "path": { "type": "string", "pattern": "^(tables/[a-z_][a-z0-9_]*\\.(jsonl|csv)|assets\\.geojson|parcels\\.geojson|schema\\.sql|README\\.txt|schemas/[a-z_]+\\.schema\\.json|photos/[0-9a-f]{2}/[0-9a-f]{64}\\.(jpg|png|webp))$" },
          "bytes": { "type": "integer", "minimum": 0 },
          "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" }
        }
      },
      "allOf": [
        { "contains": { "properties": { "path": { "const": "schema.sql" } } } },
        { "contains": { "properties": { "path": { "const": "README.txt" } } } },
        { "contains": { "properties": { "path": { "const": "assets.geojson" } } } }
      ]
    }
  }
}
