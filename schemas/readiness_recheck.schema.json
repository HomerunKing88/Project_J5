{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://j5.local/schemas/readiness_recheck.schema.json",
  "title": "계약 직전·잔금 직전 재확인 입력 (j5 db case-recheck) 과 readiness_rechecks 행",
  "description": "데이터 사전 §11 '권리·규제·임대차 확인은 계약 직전과 잔금 직전 다시 점검한다', ADR-07. 현재 매입 준비 검토 기록에 대해 단계(pre_contract / pre_settlement)별로 항목을 다시 확인한 결과를 불변 기록으로 남긴다. 권리·임대차(rights_tenancy)와 세무·법적·규제(tax_legal)는 필수 항목이다. confirmed 는 근거 문서 1건 이상, changed·unconfirmed 는 문제로 센다. 문제가 하나라도 있으면 outcome 은 issues_found 여야 하고 purchase_ready 는 철회된다.",
  "type": "object",
  "additionalProperties": false,
  "required": ["kind", "asset_id", "stage", "reviewed_on", "outcome", "items", "issues", "note"],
  "properties": {
    "kind": { "const": "stage_recheck" },
    "asset_id": { "$ref": "#/$defs/uuid" },
    "stage": { "type": "string", "enum": ["pre_contract", "pre_settlement"] },
    "reviewed_on": { "$ref": "#/$defs/date" },
    "outcome": { "type": "string", "enum": ["cleared", "issues_found"] },
    "items": {
      "type": "array",
      "minItems": 2,
      "maxItems": 8,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["key", "result", "evidence_ids", "note"],
        "properties": {
          "key": { "type": "string", "enum": ["scope_price", "financing", "tax_legal", "rights_tenancy", "building_land", "business_funding", "negotiation", "final_decision"] },
          "result": { "description": "confirmed: 이전 확인이 그대로 유효, changed: 바뀐 것을 확인, unconfirmed: 확인하지 못함", "type": "string", "enum": ["confirmed", "changed", "unconfirmed"] },
          "evidence_ids": { "type": "array", "maxItems": 50, "uniqueItems": true, "items": { "$ref": "#/$defs/uuid" } },
          "note": { "type": ["string", "null"], "maxLength": 2000 }
        },
        "if": { "properties": { "result": { "const": "confirmed" } } },
        "then": { "properties": { "evidence_ids": { "minItems": 1 } } }
      },
      "allOf": [
        { "contains": { "properties": { "key": { "const": "rights_tenancy" } } } },
        { "contains": { "properties": { "key": { "const": "tax_legal" } } } }
      ]
    },
    "issues": { "type": "array", "maxItems": 50, "items": { "type": "string", "minLength": 1, "maxLength": 2000 } },
    "note": { "type": ["string", "null"], "maxLength": 2000 }
  },
  "$defs": {
    "uuid": { "type": "string", "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$" },
    "date": { "type": "string", "format": "date", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$" }
  }
}
