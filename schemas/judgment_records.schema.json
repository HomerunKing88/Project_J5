{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://j5.local/schemas/judgment_records.schema.json",
  "title": "목표 매수가·투자판단 기록 입력 (j5 db record-add) 과 payload 정의 (records.record_type target_price / investment_judgment)",
  "description": "데이터 사전 §8. 기록은 불변이며 수정은 새 기록 + supersedes_id 다. 관측일(observed_at)은 판단일이고 날짜 정밀도만 쓴다. 정본 반영 시각(recorded_at)은 PC 가 부여한다. 금액은 원 단위 정수. 실제 거래가·호가는 이 기록에 넣지 않고 비교 근거로만 참조한다.",
  "type": "object",
  "additionalProperties": false,
  "required": ["kind", "asset_id", "record_type", "source_kind", "observed_at", "payload"],
  "properties": {
    "kind": { "const": "record" },
    "asset_id": { "$ref": "#/$defs/uuid" },
    "record_type": { "type": "string", "enum": ["target_price", "investment_judgment"] },
    "source_kind": { "type": "string", "enum": ["personal_estimate", "scenario_assumption"] },
    "observed_at": { "description": "판단일 (YYYY-MM-DD)", "type": "string", "format": "date", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$" },
    "supersedes_id": { "description": "수정하는 이전 기록 ID. 같은 물건·같은 종류여야 한다", "oneOf": [{ "$ref": "#/$defs/uuid" }, { "type": "null" }] },
    "evidence": {
      "description": "근거 문서 연결 (source_documents 에 먼저 있어야 한다)",
      "type": "array", "maxItems": 50,
      "items": {
        "type": "object", "additionalProperties": false, "required": ["document_id"],
        "properties": {
          "document_id": { "$ref": "#/$defs/uuid" },
          "field_path": { "type": "string", "pattern": "^\\$(\\..+)?$", "default": "$" },
          "locator": { "type": ["string", "null"], "maxLength": 500 },
          "verification_status": { "type": "string", "enum": ["unverified", "verified", "disputed"] }
        }
      }
    },
    "payload": {
      "oneOf": [{ "$ref": "#/$defs/target_price_payload" }, { "$ref": "#/$defs/investment_judgment_payload" }]
    }
  },
  "allOf": [
    { "if": { "properties": { "record_type": { "const": "target_price" } } }, "then": { "properties": { "payload": { "$ref": "#/$defs/target_price_payload" } } } },
    { "if": { "properties": { "record_type": { "const": "investment_judgment" } } }, "then": { "properties": { "payload": { "$ref": "#/$defs/investment_judgment_payload" } } } }
  ],
  "$defs": {
    "uuid": { "type": "string", "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$" },
    "date": { "type": "string", "format": "date", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$" },
    "text": { "type": ["string", "null"], "maxLength": 4000 },
    "target_price_payload": {
      "description": "목표 매수가: 가격 종류, 가격, 판단일, 전략, asset 구성 버전, 비용·규제 전제, 비교 근거, 유효 조건, 수정 사유 (이전 기록은 records.supersedes_id)",
      "type": "object",
      "additionalProperties": false,
      "required": ["price_kind", "price_krw", "decided_on", "strategy", "composition_as_of", "assumptions", "comparison_basis", "valid_conditions", "revision_reason"],
      "properties": {
        "price_kind": { "description": "target_buy: 목표 매수가, walk_away: 상한(이 위면 중단), reference: 참고 추정", "type": "string", "enum": ["target_buy", "walk_away", "reference"] },
        "price_krw": { "description": "원 단위 정수 (보증금 차감 전 계약 총액 기준, ADR-08)", "type": "integer", "minimum": 0, "maximum": 9007199254740991 },
        "decided_on": { "$ref": "#/$defs/date" },
        "strategy": { "type": "string", "minLength": 1, "maxLength": 200 },
        "composition_as_of": { "description": "가정한 물건 구성(필지·건물)의 기준일. 그 날짜에 유효한 asset_components 를 뜻한다", "$ref": "#/$defs/date" },
        "assumptions": { "description": "비용·규제 전제", "type": "array", "maxItems": 50, "items": { "type": "string", "minLength": 1, "maxLength": 1000 } },
        "comparison_basis": {
          "description": "비교 근거: 정본 거래(transaction_id)·호가·추정 등. 실거래가·호가 자체를 목표가로 쓰지 않는다",
          "type": "array", "maxItems": 100,
          "items": {
            "type": "object", "additionalProperties": false, "required": ["kind", "note"],
            "properties": {
              "kind": { "type": "string", "enum": ["transaction", "asking_price", "broker_report", "personal_estimate", "other"] },
              "ref_id": { "oneOf": [{ "$ref": "#/$defs/uuid" }, { "type": "null" }] },
              "note": { "type": "string", "minLength": 1, "maxLength": 1000 }
            }
          }
        },
        "valid_conditions": { "description": "이 목표가가 유효한 조건 (바뀌면 재판단)", "type": "array", "maxItems": 50, "items": { "type": "string", "minLength": 1, "maxLength": 1000 } },
        "revision_reason": { "description": "이전 기록을 수정하는 이유 (첫 기록은 null)", "$ref": "#/$defs/text" }
      }
    },
    "investment_judgment_payload": {
      "description": "투자판단 10항목. status=draft 는 일부만 채울 수 있고 formal 은 10항목 모두 필요. 승인·철회도 새 기록(decision)으로 남긴다",
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "decision", "strategy", "alternatives", "current_price_gap", "price_gap_change_conditions", "demand", "usability_and_constraints",
                   "financing_cash_flow", "counter_evidence", "judgment_change_conditions", "purchase_conditions_next_checks", "note"],
      "properties": {
        "status": { "type": "string", "enum": ["draft", "formal"] },
        "decision": { "description": "none: 판단 기록만, approved: 본인 승인, withdrawn: 승인 철회 (이전 기록을 supersedes_id 로 가리킨다)", "type": "string", "enum": ["none", "approved", "withdrawn"] },
        "strategy": { "$ref": "#/$defs/text" },
        "alternatives": { "description": "대체재", "$ref": "#/$defs/text" },
        "current_price_gap": { "description": "현재 가격차", "$ref": "#/$defs/text" },
        "price_gap_change_conditions": { "description": "가격차 변화 조건", "$ref": "#/$defs/text" },
        "demand": { "description": "수요", "$ref": "#/$defs/text" },
        "usability_and_constraints": { "description": "활용 가능성과 제약", "$ref": "#/$defs/text" },
        "financing_cash_flow": { "description": "자금·현금흐름", "$ref": "#/$defs/text" },
        "counter_evidence": { "description": "반대 근거", "$ref": "#/$defs/text" },
        "judgment_change_conditions": { "description": "판단 변경 조건", "$ref": "#/$defs/text" },
        "purchase_conditions_next_checks": { "description": "매입 조건·다음 확인사항", "$ref": "#/$defs/text" },
        "note": { "$ref": "#/$defs/text" }
      },
      "allOf": [
        {
          "if": { "properties": { "status": { "const": "formal" } } },
          "then": {
            "properties": {
              "strategy": { "type": "string", "minLength": 1 }, "alternatives": { "type": "string", "minLength": 1 }, "current_price_gap": { "type": "string", "minLength": 1 },
              "price_gap_change_conditions": { "type": "string", "minLength": 1 }, "demand": { "type": "string", "minLength": 1 },
              "usability_and_constraints": { "type": "string", "minLength": 1 }, "financing_cash_flow": { "type": "string", "minLength": 1 },
              "counter_evidence": { "type": "string", "minLength": 1 }, "judgment_change_conditions": { "type": "string", "minLength": 1 },
              "purchase_conditions_next_checks": { "type": "string", "minLength": 1 }
            }
          }
        },
        {
          "description": "승인은 정식 판단에만 한다",
          "if": { "properties": { "decision": { "const": "approved" } } },
          "then": { "properties": { "status": { "const": "formal" } } }
        }
      ]
    }
  }
}
