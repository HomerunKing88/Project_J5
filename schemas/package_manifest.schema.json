{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://j5.local/schemas/package_manifest.schema.json",
  "title": "<batch>.j5field.zip manifest.json",
  "description": "데이터 사전 §3.1·§3.3. 패키지 안의 파일 목록과 해시. 경로는 상대경로만 허용하고 사진은 내용 해시 이름만 허용한다.",
  "type": "object",
  "additionalProperties": false,
  "required": ["format", "schema_version", "study_id", "package_id", "created_at", "data_mode", "files"],
  "properties": {
    "format": { "type": "string", "const": "j5field" },
    "schema_version": {
      "description": "package_schema 버전. 현재 1.0.0",
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
    },
    "study_id": { "type": "string", "minLength": 1, "maxLength": 100 },
    "package_id": {
      "type": "string",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
    },
    "created_at": { "type": "string", "format": "date-time", "pattern": "(Z|[+-][0-9]{2}:[0-9]{2})$" },
    "data_mode": { "type": "string", "enum": ["synthetic", "private_real"] },
    "files": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["path", "bytes", "sha256"],
        "properties": {
          "path": {
            "type": "string",
            "pattern": "^(observations\\.jsonl|photos/[0-9a-f]{64}\\.(jpg|png|webp))$"
          },
          "bytes": { "type": "integer", "minimum": 0, "maximum": 20000000 },
          "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" }
        }
      },
      "contains": { "properties": { "path": { "const": "observations.jsonl" } } }
    }
  }
}
