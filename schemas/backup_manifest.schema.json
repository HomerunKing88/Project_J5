{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://j5.local/schemas/backup_manifest.schema.json",
  "title": "backups/<stamp>-ds<version>-<run8>/backup_manifest.json (정본 백업)",
  "description": "데이터 사전 §12·ADR E07. SQLite 백업 API 로 만든 일관된 정본 사본(db/j5.sqlite3)과 첨부가 참조한 사진(photos/<sha 앞 2자>/<sha>.<ext>)의 목록·바이트·해시. dataset_version·db_schema_version·행 수를 함께 담아 복구 후 대조한다.",
  "type": "object",
  "additionalProperties": false,
  "required": ["format", "backup_schema_version", "study_id", "data_mode", "dataset_version", "db_schema_version", "created_at", "run_id", "tool_version", "sqlite_version", "counts", "files"],
  "properties": {
    "format": { "type": "string", "const": "j5backup" },
    "backup_schema_version": { "type": "string", "enum": ["1.0.0"] },
    "study_id": { "type": "string", "minLength": 1, "maxLength": 100 },
    "data_mode": { "type": "string", "enum": ["synthetic", "private_real"] },
    "dataset_version": { "type": "integer", "minimum": 0 },
    "db_schema_version": { "type": "integer", "minimum": 1 },
    "created_at": { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$" },
    "run_id": { "type": "string", "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$" },
    "tool_version": { "type": "string", "minLength": 1 },
    "sqlite_version": { "type": "string", "minLength": 1 },
    "counts": {
      "description": "정본 사본의 테이블별 행 수 (모든 사용자 테이블). 복구 후 같아야 한다",
      "type": "object",
      "required": ["subjects", "assets", "records", "record_evidence", "attachments"],
      "additionalProperties": { "type": "integer", "minimum": 0 }
    },
    "files": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["path", "bytes", "sha256"],
        "properties": {
          "path": { "type": "string", "pattern": "^(db/j5\\.sqlite3|photos/[0-9a-f]{2}/[0-9a-f]{64}\\.(jpg|png|webp))$" },
          "bytes": { "type": "integer", "minimum": 1 },
          "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" }
        }
      },
      "contains": { "properties": { "path": { "const": "db/j5.sqlite3" } } }
    }
  }
}
