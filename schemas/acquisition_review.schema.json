{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://j5.local/schemas/acquisition_review.schema.json",
  "title": "매입 준비 검토 기록 입력 (j5 db case-add) 과 저장 payload",
  "description": "데이터 사전 §11, 릴리스 계획 §9 R7, ADR-07. 매입 검토 사건(acquisition_case)마다 구성 범위·가격·전략·금융·임대차·규제·실사·협상안을 묶고 체크리스트 8항목의 상태·근거·검토자·검토일·유효기한·재검토 조건·미해결 사항을 둔다. 불변 기록이며 수정은 새 기록 + supersedes_id. purchase_ready 전환은 별도 결정(readiness_decisions)이며 이 기록이 상태를 바꾸지 않는다. 정해지지 않은 기한을 자동으로 채우지 않는다.",
  "type": "object",
  "additionalProperties": false,
  "required": ["kind", "asset_id", "record_type", "source_kind", "observed_at", "payload"],
  "properties": {
    "kind": { "const": "acquisition_review" },
    "asset_id": { "$ref": "#/$defs/uuid" },
    "record_type": { "const": "acquisition_review" },
    "source_kind": { "description": "검토는 소유자 본인의 판단이다", "const": "personal_estimate" },
    "observed_at": { "description": "검토일 (YYYY-MM-DD)", "$ref": "#/$defs/date" },
    "supersedes_id": { "description": "수정하는 이전 검토 기록 ID. 같은 물건의 현재 검토 기록이어야 한다", "oneOf": [{ "$ref": "#/$defs/uuid" }, { "type": "null" }] },
    "evidence": {
      "type": "array",
      "maxItems": 50,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["document_id"],
        "properties": {
          "document_id": { "$ref": "#/$defs/uuid" },
          "field_path": { "type": "string", "pattern": "^\\$(\\..+)?$", "default": "$" },
          "locator": { "type": ["string", "null"], "maxLength": 500 },
          "verification_status": { "type": "string", "enum": ["unverified", "verified", "disputed"] }
        }
      }
    },
    "payload": { "$ref": "#/$defs/acquisition_review_payload" }
  },
  "$defs": {
    "uuid": { "type": "string", "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$" },
    "date": { "type": "string", "format": "date", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$" },
    "text": { "type": "string", "minLength": 1, "maxLength": 2000 },
    "krw": { "type": "integer", "minimum": 0, "maximum": 1000000000000000 },
    "check_key": { "type": "string", "enum": ["scope_price", "financing", "tax_legal", "rights_tenancy", "building_land", "business_funding", "negotiation", "final_decision"] },
    "check_status": { "type": "string", "enum": ["not_started", "in_progress", "verified", "conditional", "blocked", "not_applicable"] },
    "recheck_trigger": {
      "description": "이 검토를 다시 요구하는 변경 종류 (데이터 사전 §11: 가격·대출·임대보증금·전략·구성 토지·규제·중요 실사 결과)",
      "type": "string",
      "enum": ["price", "loan", "deposit", "strategy", "composition", "regulation", "due_diligence", "tenancy"]
    },
    "check": {
      "type": "object",
      "additionalProperties": false,
      "required": ["key", "status", "evidence_ids", "reviewer_role", "checked_at", "valid_until", "recheck_triggers", "open_issues", "not_applicable_reason"],
      "properties": {
        "key": { "$ref": "#/$defs/check_key" },
        "status": { "$ref": "#/$defs/check_status" },
        "evidence_ids": { "description": "근거 문서 ID (source_documents). verified 면 1건 이상", "type": "array", "maxItems": 50, "uniqueItems": true, "items": { "$ref": "#/$defs/uuid" } },
        "reviewer_role": { "type": "string", "enum": ["self", "broker", "lawyer", "tax_advisor", "architect", "bank", "appraiser", "other"] },
        "checked_at": { "description": "검토일. verified 면 필수", "oneOf": [{ "$ref": "#/$defs/date" }, { "type": "null" }] },
        "valid_until": { "description": "유효기한. 정해지지 않았으면 null 로 두고 자동으로 채우지 않는다", "oneOf": [{ "$ref": "#/$defs/date" }, { "type": "null" }] },
        "recheck_triggers": { "description": "항목의 기본 재검토 조건(도구가 정한 최소 매핑, j5/db/readiness.py MANDATORY_TRIGGERS)에 더하는 조건. 기본 조건은 뺄 수 없다", "type": "array", "maxItems": 8, "uniqueItems": true, "items": { "$ref": "#/$defs/recheck_trigger" } },
        "open_issues": { "type": "array", "maxItems": 50, "items": { "$ref": "#/$defs/text" } },
        "not_applicable_reason": { "oneOf": [{ "$ref": "#/$defs/text" }, { "type": "null" }] },
        "note": { "type": ["string", "null"], "maxLength": 2000 }
      },
      "allOf": [
        { "if": { "properties": { "status": { "const": "verified" } } }, "then": { "properties": { "checked_at": { "$ref": "#/$defs/date" }, "evidence_ids": { "minItems": 1 } } } },
        { "if": { "properties": { "status": { "const": "not_applicable" } } }, "then": { "properties": { "not_applicable_reason": { "$ref": "#/$defs/text" } } } },
        { "if": { "properties": { "status": { "enum": ["conditional", "blocked"] } } }, "then": { "properties": { "open_issues": { "minItems": 1 } } } }
      ]
    },
    "acquisition_review_payload": {
      "type": "object",
      "additionalProperties": false,
      "required": ["strategy", "scope", "price", "references", "listing_event", "checklist_version", "checks", "note"],
      "properties": {
        "strategy": { "$ref": "#/$defs/text" },
        "scope": {
          "type": "object",
          "additionalProperties": false,
          "required": ["ownership_kind", "share_ratio", "parcel_pnus", "buildings", "composition_as_of", "note"],
          "properties": {
            "ownership_kind": { "type": "string", "enum": ["full", "share", "strata"] },
            "share_ratio": { "description": "지분 매입이면 0 초과 1 이하", "oneOf": [{ "type": "number", "exclusiveMinimum": 0, "maximum": 1 }, { "type": "null" }] },
            "parcel_pnus": { "type": "array", "maxItems": 50, "uniqueItems": true, "items": { "type": "string", "pattern": "^[0-9]{19}$" } },
            "buildings": { "type": "array", "maxItems": 50, "items": { "$ref": "#/$defs/text" } },
            "composition_as_of": { "description": "가정한 물건 구성(asset_components)의 기준일", "$ref": "#/$defs/date" },
            "note": { "type": ["string", "null"], "maxLength": 2000 }
          },
          "allOf": [
            { "if": { "properties": { "ownership_kind": { "const": "share" } } }, "then": { "properties": { "share_ratio": { "type": "number" } } } }
          ]
        },
        "price": {
          "type": "object",
          "additionalProperties": false,
          "required": ["gross_contract_krw", "basis", "reason", "deposit_total_krw", "deposit_basis", "vat_status", "asking_confirmation"],
          "properties": {
            "gross_contract_krw": { "description": "보증금 차감 전 계약 총액 (ADR-08). 미확인이면 null 과 사유", "oneOf": [{ "$ref": "#/$defs/krw" }, { "type": "null" }] },
            "basis": { "type": ["string", "null"], "maxLength": 500 },
            "reason": { "type": ["string", "null"], "maxLength": 500 },
            "deposit_total_krw": { "description": "승계 보증금 총액. 명세 미확인이면 null 과 사유", "oneOf": [{ "$ref": "#/$defs/krw" }, { "type": "null" }] },
            "deposit_basis": { "type": ["string", "null"], "maxLength": 500 },
            "vat_status": { "type": "string", "enum": ["included", "excluded", "unknown"] },
            "asking_confirmation": { "type": "string", "enum": ["broker_verbal", "written_offer", "contract_draft", "unknown"] }
          },
          "allOf": [
            { "if": { "properties": { "gross_contract_krw": { "type": "null" } } }, "then": { "properties": { "reason": { "type": "string", "minLength": 1 } } } },
            { "if": { "properties": { "gross_contract_krw": { "type": "integer" } } }, "then": { "properties": { "basis": { "type": "string", "minLength": 1 } } } },
            { "if": { "properties": { "deposit_total_krw": { "type": "null" } } }, "then": { "properties": { "deposit_basis": { "type": "string", "minLength": 1 } } } }
          ]
        },
        "references": {
          "description": "이 검토가 전제한 현재 기록 (같은 물건의 수정되지 않은 기록이어야 한다). 없으면 null",
          "type": "object",
          "additionalProperties": false,
          "required": ["target_price_id", "investment_judgment_id", "financing_plan_id", "development_plan_id", "regulation_review_id"],
          "properties": {
            "target_price_id": { "oneOf": [{ "$ref": "#/$defs/uuid" }, { "type": "null" }] },
            "investment_judgment_id": { "oneOf": [{ "$ref": "#/$defs/uuid" }, { "type": "null" }] },
            "financing_plan_id": { "oneOf": [{ "$ref": "#/$defs/uuid" }, { "type": "null" }] },
            "development_plan_id": { "oneOf": [{ "$ref": "#/$defs/uuid" }, { "type": "null" }] },
            "regulation_review_id": { "oneOf": [{ "$ref": "#/$defs/uuid" }, { "type": "null" }] }
          }
        },
        "listing_event": {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "noted_on", "note"],
          "properties": {
            "kind": { "type": "string", "enum": ["none", "broker_offer", "public_listing", "auction", "other"] },
            "noted_on": { "oneOf": [{ "$ref": "#/$defs/date" }, { "type": "null" }] },
            "note": { "type": ["string", "null"], "maxLength": 2000 }
          }
        },
        "checklist_version": { "const": "1.0.0" },
        "checks": {
          "description": "8항목 전부, 각 1회",
          "type": "array",
          "minItems": 8,
          "maxItems": 8,
          "items": { "$ref": "#/$defs/check" },
          "allOf": [
            { "contains": { "properties": { "key": { "const": "scope_price" } } } },
            { "contains": { "properties": { "key": { "const": "financing" } } } },
            { "contains": { "properties": { "key": { "const": "tax_legal" } } } },
            { "contains": { "properties": { "key": { "const": "rights_tenancy" } } } },
            { "contains": { "properties": { "key": { "const": "building_land" } } } },
            { "contains": { "properties": { "key": { "const": "business_funding" } } } },
            { "contains": { "properties": { "key": { "const": "negotiation" } } } },
            { "contains": { "properties": { "key": { "const": "final_decision" } } } }
          ]
        },
        "note": { "type": ["string", "null"], "maxLength": 2000 }
      }
    }
  }
}
