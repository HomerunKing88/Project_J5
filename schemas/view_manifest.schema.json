{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://j5.local/schemas/view_manifest.schema.json",
  "title": "<study>-ds<version>-<stamp>.j5view.zip manifest.json (조회 파생본)",
  "description": "데이터 사전 §4·ADR-03. 정본의 고정 dataset_version 에서 전량 생성한 조회 패키지. source_dataset_version·projection_schema_version·generated_at·scope_ids·data_mode 를 담고, 파일 목록은 경로·바이트·해시로 검증한다.",
  "type": "object",
  "additionalProperties": false,
  "required": ["format", "projection_schema_version", "study_id", "data_mode", "source_dataset_version", "generated_at", "run_id", "scope_ids", "counts", "files"],
  "properties": {
    "format": { "type": "string", "const": "j5view" },
    "projection_schema_version": { "type": "string", "enum": ["1.0.0"] },
    "study_id": { "type": "string", "minLength": 1, "maxLength": 100 },
    "data_mode": { "type": "string", "enum": ["synthetic", "private_real"] },
    "source_dataset_version": { "type": "integer", "minimum": 0 },
    "generated_at": { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$" },
    "run_id": { "type": "string", "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$" },
    "scope_ids": {
      "description": "이 파생본에 담긴 매입 검토 단위(asset_id) 전체. 정렬된 목록",
      "type": "array",
      "uniqueItems": true,
      "items": { "type": "string", "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$" }
    },
    "counts": {
      "type": "object",
      "additionalProperties": false,
      "required": ["assets", "located", "records", "attachments", "photos"],
      "properties": {
        "assets": { "type": "integer", "minimum": 0 },
        "located": { "type": "integer", "minimum": 0 },
        "records": { "type": "integer", "minimum": 0 },
        "attachments": { "type": "integer", "minimum": 0 },
        "photos": { "type": "integer", "minimum": 0 },
        "parcels": { "description": "parcels.geojson 의 필지 수 (J5-013B-2). 없으면 0 또는 생략", "type": "integer", "minimum": 0 }
      }
    },
    "files": {
      "type": "array",
      "minItems": 3,
      "uniqueItems": true,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["path", "bytes", "sha256"],
        "properties": {
          "path": { "type": "string", "pattern": "^(assets\\.seed\\.json|assets\\.geojson|records\\.jsonl|parcels\\.geojson|photos/[0-9a-f]{64}\\.(jpg|png|webp))$" },
          "bytes": { "type": "integer", "minimum": 0 },
          "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" }
        }
      },
      "allOf": [
        { "contains": { "properties": { "path": { "const": "assets.seed.json" } } } },
        { "contains": { "properties": { "path": { "const": "assets.geojson" } } } },
        { "contains": { "properties": { "path": { "const": "records.jsonl" } } } }
      ]
    }
  }
}
